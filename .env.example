# nock — environment. Copy to .env and fill in. .env is gitignored.
#
# There is NO send path in this repo yet (P0). Both safety flags below default to
# the safe value and every future send path must re-check LIVE_TRADING at the last
# possible moment (CLAUDE.md invariant 5).

# ── chain ───────────────────────────────────────────────────────────────────
# Robinhood Chain (Arbitrum Orbit L2) public RPC.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# ── explorer (read-only, public) ────────────────────────────────────────────
# Blockscout v2 REST API — used by scripts/recon.ts for creation-tx tracing and
# verified-source lookups. No key required.
EXPLORER_API=https://robinhoodchain.blockscout.com/api

# ── safety flags ────────────────────────────────────────────────────────────
# DRY_RUN=true    → build and simulate calldata, never broadcast.
# LIVE_TRADING=false → no send path may execute, at all.
# Flipping LIVE_TRADING to true requires an explicit in-session approval from Rory
# and a first canary of <= 0.005 ETH.
DRY_RUN=true
LIVE_TRADING=false
